# ─── EYZA Environment Variables ──────────────────────────────────────────

# Database (PostgreSQL — Neon / Supabase / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/eyza?schema=public"

# NextAuth / Auth.js
AUTH_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
# NextAuth URL (for development: http://localhost:3000)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth Application (Settings > Developer settings > OAuth Apps)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Secret Encryption (AES-256 for storing user GitHub tokens at rest)
TOKEN_ENCRYPTION_SECRET="change-this-to-32-byte-secret-hex-or-base64"

# AI Provider Keys
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Vercel Deployment Integration (Milestone 8)
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# Application Config
NODE_ENV="development"
PORT=3000
